# ------------------------------------------------------------------
# istendencia · plataforma de clima organizacional
# Copiar a .env y completar. NUNCA versionar el .env real.
# ------------------------------------------------------------------

# Secreto de firma de cookies de sesión y de tickets de respuesta.
# Generar con: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambiar-esto-en-produccion

# Base de datos. En desarrollo/test puede ser SQLite.
#   PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/clima
#   SQLite:     sqlite:///./clima.db
DATABASE_URL=sqlite:///./clima.db

# Cookies Secure (1 en producción tras HTTPS; 0 en desarrollo local sin TLS)
SECURE_COOKIES=0

# Duración de la sesión de plataforma, en segundos (8 h)
SESSION_TTL=28800

# Duración del ticket que permite retomar una encuesta, en segundos (30 días)
RESPONSE_TICKET_TTL=2592000

# Umbral de anonimato por defecto para organizaciones nuevas
DEFAULT_ANONYMITY_THRESHOLD=7

# Porcentaje mínimo de ítems respondidos para calcular una dimensión (0-1)
DEFAULT_MIN_ITEM_COMPLETION=0.6

# Entorno: development | production
ENVIRONMENT=development

# Base pública para construir enlaces de invitación
PUBLIC_BASE_URL=http://localhost:8003

# Sembrar datos de demostración al iniciar (1 = sí). Datos ficticios marcados como demo.
SEED_DEMO=1
